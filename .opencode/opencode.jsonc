{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "deepseek": {
      "name": "DeepSeek",
      "options": {
        "apiKey": "sk-bc4a623c78434100bcba4d1f6ef96e33",
        "baseURL": "https://api.deepseek.com",
      },
      "models": {
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision Exp",
          "tool_call": true,
          "temperature": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "ui-server": { "type": "local", "command": ["bun", "run", "packages/opencode/test/mcp/fixtures/ui-server.ts"] },
    "simple-server": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "timeout": 7200000,
    },
    "plant-level": {
      "type": "remote",
      "url": "http://10.30.70.120:8001/mcp",
      "timeout": 7200000,
    },
    "device-tower": {
      "type": "remote",
      "url": "http://10.30.70.120:8002/mcp",
      "timeout": 7200000,
    },
    "device-reactor": {
      "type": "remote",
      "url": "http://10.30.70.120:8003/mcp",
      "timeout": 7200000,
    },
    "pdf2json": {
      "type": "remote",
      "url": "http://localhost:8008/mcp",
      "timeout": 7200000,
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "experimental": {
    "mcp_timeout": 7200000,
  },
}
